{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/confirm_git.py\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/check_notebook.py\"",
            "statusMessage": "Checking notebook syntax..."
          }
        ]
      }
    ]
  }
}
